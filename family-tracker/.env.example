# Скопируйте этот файл в .env.local и заполните значения.
# Где взять: Supabase → Project Settings → API (подробно — в README).

# Адрес проекта Supabase, например https://abcdefgh.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# Publishable key (sb_publishable_…) или старый anon key — он безопасен для браузера
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Адрес сайта для ссылок в письмах. На Vercel: https://<ваш-проект>.vercel.app
# Локально можно не заполнять.
NEXT_PUBLIC_SITE_URL=

# AI (этап 5): ключ Claude API — только на сервере, никогда не NEXT_PUBLIC_.
# Без него приложение работает, просто кнопки AI показывают подсказку.
ANTHROPIC_API_KEY=
# Для автотестов: AI_MOCK=1 — заготовленные ответы вместо обращений к API.
# AI_MOCK=

# Появятся на следующих этапах (только на сервере, никогда не NEXT_PUBLIC_):
# GOOGLE_CLIENT_ID=           # этап 6 — Google Calendar
# GOOGLE_CLIENT_SECRET=
# VAPID_PRIVATE_KEY=          # этап 7 — push-напоминания
